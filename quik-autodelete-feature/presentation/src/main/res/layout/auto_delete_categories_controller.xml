<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contentView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_notifications_black_24dp"
            app:summary="@string/auto_delete_categories_notifications_summary"
            app:title="@string/auto_delete_categories_notifications_title"
            app:widget="@layout/settings_switch_widget" />

        <dev.octoshrimpy.quik.common.widget.PreferenceView
            android:id="@+id/verificationCodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_verified_black_24dp"
            app:summary="@string/auto_delete_categories_verification_summary"
            app:title="@string/auto_delete_categories_verification_title"
            app:widget="@layout/settings_switch_widget" />

        <dev.octoshrimpy.quik.common.widget.QkTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="?android:attr/textColorTertiary"
            app:textSize="secondary"
            android:text="@string/auto_delete_categories_footer" />

    </LinearLayout>

</ScrollView>
